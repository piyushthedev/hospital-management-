# ==============================================================================
# Hospital Management System - Production Environment Configuration
# ==============================================================================

# Server Environment
NODE_ENV=production
PORT=3000
HOST=0.0.0.0

# Security: Replace with a cryptographically secure random string (e.g. openssl rand -hex 32)
JWT_SECRET=replace-with-a-secure-random-64-character-hex-string-for-production

# Persistent SQLite Database Location
DB_PATH=/app/data/hospital.db

# Optional AWS S3 Backup Bucket for Database
# AWS_S3_BACKUP_BUCKET=my-hospital-backups-bucket
# AWS_DEFAULT_REGION=us-east-1

